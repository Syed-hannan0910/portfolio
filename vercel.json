{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/public/css/(.*)",
      "dest": "frontend/public/css/$1"
    },
    {
      "src": "/public/js/(.*)",
      "dest": "frontend/public/js/$1"
    },
    {
      "src": "/public/images/(.*)",
      "dest": "frontend/public/images/$1"
    },
    {
      "src": "/public/(.*\\.pdf)",
      "dest": "frontend/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
  
}
